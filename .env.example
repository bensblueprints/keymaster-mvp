# Keymaster configuration
# Port the server listens on
PORT=5328

# Password for the admin dashboard (/admin). CHANGE THIS.
ADMIN_PASSWORD=change-me

# Public base URL of this server (used in signed download URLs and webhook payloads)
BASE_URL=http://localhost:5328

# Where SQLite db, ed25519 keys and uploaded artifacts live (default ./data)
# DATA_DIR=./data

# Signed download URL lifetime in seconds (default 900 = 15 minutes)
# DOWNLOAD_TTL=900
